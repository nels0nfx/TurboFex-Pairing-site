# Copy to .env (or set these in your host's panel). Everything is optional.
PORT=3000
# Secret used to encrypt saved sessions. If empty, one is generated and saved in data/secret.key (keep that file!)
SITE_SECRET=
# Set to 1 when the site is behind a proxy (Cloudflare, Nginx, a panel) so rate limits use the real visitor address
TRUST_PROXY=1
# How long a session ID stays valid if nobody uses it
SESSION_TTL_HOURS=24
# 1 = a session ID can be used ONCE (recommended). 0 = it can be fetched again until it expires
ONE_TIME=1
# Pairing codes one visitor may ask for in 15 minutes
PAIR_LIMIT=4
# How many numbers may be linking at the same moment
MAX_JOBS=15
