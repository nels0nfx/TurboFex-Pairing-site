# Copy to .env (or set these in your host's panel). Everything is optional.
PORT=3000
# Secret used to encrypt saved sessions. If empty, one is generated and saved in data/secret.key (keep that file!)
SITE_SECRET=
# Set to 1 when the site is behind a proxy (Cloudflare, Nginx, a panel) so rate limits use the real visitor address
TRUST_PROXY=1
# How long (in seconds) a session ID stays valid if the bot has not used it. 300 = 5 minutes. An ID always works only once
SESSION_TTL_SECONDS=300
# Pairing codes one visitor may ask for in 15 minutes
PAIR_LIMIT=4
# How many numbers may be linking at the same moment
MAX_JOBS=15

# Admin dashboard (optional). Make this line with: node tools/admin-setup.js
# ADMIN_ACCOUNTS=

# Permanent storage for the admin data (optional, see TURBOFEX_AI_NOTES.md section 18)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
