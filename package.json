{
  "name": "turbofex-pairsite",
  "version": "3.22.0",
  "description": "TurboFex pairing site: link WhatsApp with a pairing code and get a short session ID",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "web:install": "npm --prefix web install",
    "web:verify": "npm --prefix web run verify",
    "web:build": "npm --prefix web run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "libphonenumber-js": "^1.11.0"
  },
  "license": "MIT"
}
